# ISO8583Studio - Lightweight Dockerfile (Pre-built JAR)
# Use this when you already have the JAR built locally
# Smaller image, faster builds for CI/CD

FROM eclipse-temurin:21-jre

LABEL maintainer="AiCortex Solutions Pvt. Ltd."
LABEL description="ISO8583Studio Demo - noVNC (Lite)"

# Install minimal X11 + VNC dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libxext6 \
    libx11-6 \
    libfreetype6 \
    fontconfig \
    fonts-dejavu-core \
    openbox \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create app user
RUN useradd -m -s /bin/bash appuser

# Environment
ENV DISPLAY=:99
ENV RESOLUTION=1280x800x24
ENV HOME=/home/appuser

# Create directories
RUN mkdir -p /app /home/appuser/.config/openbox

# Copy pre-built JAR (build locally first: ./gradlew :composeApp:packageUberJarForCurrentOS)
COPY composeApp/build/compose/jars/*.jar /app/iso8583studio.jar

# Copy scripts
COPY deploy/scripts/start.sh /app/start.sh
COPY deploy/scripts/openbox-rc.xml /home/appuser/.config/openbox/rc.xml

RUN chmod +x /app/start.sh && \
    chown -R appuser:appuser /home/appuser /app

EXPOSE 6080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:6080/ || exit 1

USER appuser
WORKDIR /home/appuser

CMD ["/app/start.sh"]
